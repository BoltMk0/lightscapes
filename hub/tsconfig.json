{
	"compilerOptions": {
		"target": "ES2023",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true
	},
	// Also type-checks the library it's built with, from the repository root
	"include": ["src/**/*.ts", "../src/**/*.ts"],
	"exclude": ["../src/**/*.test.ts"]
}
